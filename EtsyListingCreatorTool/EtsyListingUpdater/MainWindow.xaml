<Window x:Class="EtsyListingUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EtsyListingUpdater"
        mc:Ignorable="d"
        Title="Etsy Listing Updater"
        Height="600"
        Width="850"
       Loaded="Window_Loaded">

    <Grid Margin="10">

        <TabControl>

            <!-- INPUT TAB -->
            <TabItem Header="Input">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Character Name -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,10,10"
                                   VerticalAlignment="Center"
                                   Text="Character Name:"/>

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="0,0,0,10"
                                 Name="txtCharacterName"
                                 Height="28"/>

                        <!-- Franchise -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,0,10,10"
                                   VerticalAlignment="Center"
                                   Text="Franchise:"/>

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,0,0,10"
                                 Name="txtUniverse"
                                 Height="28"/>

                        <!-- Additional Info -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,0,10,10"
                                   VerticalAlignment="Top"
                                   Text="Additional Info:"/>

                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="0,0,0,10"
                                 Name="txtInfo"
                                 Height="80"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <!-- Original Scale -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Margin="0,0,10,10"
                                   VerticalAlignment="Center"
                                   Text="Original Scale:"/>

                        <ComboBox Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  Name="cbxOgScale"
                                  Height="28">
                            <ComboBoxItem Content="1/4"/>
                            <ComboBoxItem Content="1/6"/>
                            <ComboBoxItem Content="1/7"/>
                            <ComboBoxItem Content="1/8"/>
                            <ComboBoxItem Content="Non-scale"/>
                        </ComboBox>

                        <!-- Original Size -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Margin="0,0,10,10"
                                   VerticalAlignment="Center"
                                   Text="Original Size:"/>

                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="0,0,0,10"
                                 Name="txtOriginalSize"
                                 Height="28"/>

                        <!-- Scale Options -->
                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Margin="0,0,10,10"
                                   VerticalAlignment="Center"
                                   Text="Scale Options:"/>

                        <ComboBox Grid.Row="5"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  Name="cbxScaleOptions"
                                  Height="28">
                            <ComboBoxItem Content="1/4"/>
                            <ComboBoxItem Content="1/6"/>
                            <ComboBoxItem Content="1/7"/>
                            <ComboBoxItem Content="1/8"/>
                            <ComboBoxItem Content="1/10"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>

                        <!-- Creator -->
                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Margin="0,0,10,10"
                                   VerticalAlignment="Center"
                                   Text="Creator:"/>

                        <ComboBox Grid.Row="6"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  Name="cbxCreator"
                                  Height="28">
                            <ComboBoxItem Content="MyAnimeCustoms"/>
                            <ComboBoxItem Content="CustomStudio"/>
                            <ComboBoxItem Content="Independent Artist"/>
                        </ComboBox>

                        <!-- Generate Button -->
                        <Button Grid.Row="7"
                                Grid.Column="1"
                                Width="160"
                                Height="35"
                                HorizontalAlignment="Left"
                                Content="Generate Listing" 
                                Click="Button_Click"/>

                    </Grid>

                </ScrollViewer>
            </TabItem>

            <!-- OUTPUT TAB -->
            <TabItem Header="Output">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>

                            <!-- 7 Size Rows -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- TITLE -->
                        <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,10,10"
                       VerticalAlignment="Center"
                       Text="Title:"/>

                        <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Margin="0,0,10,10"
                     Name="txtTitle"
                     Height="28"
                     IsReadOnly="True"/>

                        <Button Grid.Row="0"
                    Grid.Column="3"
                    Height="28"
                    Content="Copy"/>

                        <!-- DESCRIPTION -->
                        <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,10,10"
                       VerticalAlignment="Top"
                       Text="Description:"/>

                        <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Margin="0,0,10,10"
                     Name="txtDescription"
                     Height="120"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"/>

                        <Button Grid.Row="1"
                    Grid.Column="3"
                    Height="28"
                    VerticalAlignment="Top"
                    Content="Copy"/>

                        <!-- TAGS -->
                        <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Margin="0,0,10,10"
                       VerticalAlignment="Center"
                       Text="Tags:"/>

                        <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Margin="0,0,10,10"
                     Name="txtTags"
                     Height="60"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     IsReadOnly="True"/>

                        <Button Grid.Row="2"
                    Grid.Column="3"
                    Height="28"
                    Content="Copy"/>

                        <!-- HEADER -->
                        <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Margin="0,10,0,15"
                       FontSize="16"
                       FontWeight="Bold"
                       Text="Sizes"/>

                        <!-- SIZE ROW 1 -->
                        <TextBox Grid.Row="4"
                     Grid.Column="1"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize1Left"
                     IsReadOnly="True"/>

                        <TextBox Grid.Row="4"
                     Grid.Column="2"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize1Right"/>

                        <Button Grid.Row="4"
                    Grid.Column="3"
                    Height="28"
                    Content="Copy"/>

                        <!-- SIZE ROW 2 -->
                        <TextBox Grid.Row="5"
                     Grid.Column="1"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize2Left"
                     IsReadOnly="True"/>

                        <TextBox Grid.Row="5"
                     Grid.Column="2"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize2Right"/>

                        <Button Grid.Row="5"
                    Grid.Column="3"
                    Height="28"
                    Content="Copy"/>

                        <!-- SIZE ROW 3 -->
                        <TextBox Grid.Row="6"
                     Grid.Column="1"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize3Left"
                     IsReadOnly="True"/>

                        <TextBox Grid.Row="6"
                     Grid.Column="2"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize3Right"/>

                        <Button Grid.Row="6"
                    Grid.Column="3"
                    Height="28"
                    Content="Copy"/>

                        <!-- SIZE ROW 4 -->
                        <TextBox Grid.Row="7"
                     Grid.Column="1"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize4Left"
                     IsReadOnly="True"/>

                        <TextBox Grid.Row="7"
                     Grid.Column="2"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize4Right"/>

                        <Button Grid.Row="7"
                    Grid.Column="3"
                    Height="28"
                    Content="Copy"/>

                        <!-- SIZE ROW 5 -->
                        <TextBox Grid.Row="8"
                     Grid.Column="1"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize5Left"
                     IsReadOnly="True"/>

                        <TextBox Grid.Row="8"
                     Grid.Column="2"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize5Right"/>

                        <Button Grid.Row="8"
                    Grid.Column="3"
                    Height="28"
                    Content="Copy"/>

                        <!-- SIZE ROW 6 -->
                        <TextBox Grid.Row="9"
                     Grid.Column="1"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize6Left"
                     IsReadOnly="True"/>

                        <TextBox Grid.Row="9"
                     Grid.Column="2"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize6Right"/>

                        <Button Grid.Row="9"
                    Grid.Column="3"
                    Height="28"
                    Content="Copy"/>

                        <!-- SIZE ROW 7 -->
                        <TextBox Grid.Row="10"
                     Grid.Column="1"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize7Left"
                     IsReadOnly="True"/>

                        <TextBox Grid.Row="10"
                     Grid.Column="2"
                     Margin="0,0,10,10"
                     Height="28"
                     Name="txtSize7Right"/>

                        <Button Grid.Row="10"
                    Grid.Column="3"
                    Height="28"
                    Content="Copy"/>

                    </Grid>

                </ScrollViewer>

            </TabItem>

        </TabControl>

    </Grid>
</Window>